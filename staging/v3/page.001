<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>A+ Esthetic Frankfurt | Ästhetische Medizin, Botox & Laser</title>
<meta name="description" content="A+ Esthetic Frankfurt – moderne ästhetische Medizin, Hautbildverbesserung, Vitalitätsbehandlungen, Botox, Hyaluron, PRP, Skinbooster, Laser und mehr.">
<meta name="robots" content="noindex,nofollow">
<link rel="canonical" href="https://a-esthetic.de/">
<meta name="theme-color" content="#17120e">
<style>
:root{
 --ink:#17120e;--ink2:#211913;--paper:#f4eee5;--paper2:#ece1d2;--cream:#fbf7f0;
 --gold:#c0924f;--gold2:#e1bd78;--muted:#70665c;--line:rgba(23,18,14,.14);
 --serif:"Bodoni 72","Didot","Iowan Old Style","Times New Roman",serif;
 --sans:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",Arial,sans-serif;
 --ease:cubic-bezier(.2,.75,.2,1)
}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);overflow-x:hidden}a{color:inherit;text-decoration:none}img{display:block;width:100%;height:auto}.wrap{width:min(1320px,calc(100% - 52px));margin:auto}.eyebrow{font-size:10px;letter-spacing:.26em;text-transform:uppercase;color:var(--gold);font-weight:700}.serif{font-family:var(--serif);font-weight:400;letter-spacing:-.035em}.reveal{opacity:0;transform:translateY(18px);transition:.75s var(--ease)}.reveal.is-in{opacity:1;transform:none}.btn{display:inline-flex;align-items:center;gap:16px;border:1px solid currentColor;padding:14px 20px;font-size:10px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;transition:.25s}.btn:after{content:"→"}.btn:hover{background:var(--gold);border-color:var(--gold);color:#fff;transform:translateY(-1px)}

/* HERO */
.hero{position:relative;min-height:100svh;background:var(--ink);overflow:hidden;color:#fff}.hero-media{background:#9a8065;position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center}.hero:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(12,9,7,.9) 0 30%,rgba(12,9,7,.55) 43%,rgba(12,9,7,.08) 70%,rgba(12,9,7,.18) 100%)}.header{position:absolute;z-index:20;left:0;right:0;top:0;height:92px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;padding:0 4.5vw;border-bottom:1px solid rgba(255,255,255,.14)}.brand{font-family:var(--serif);font-size:24px;letter-spacing:.02em}.brand small{display:block;font:600 8px/1.2 var(--sans);letter-spacing:.32em;text-transform:uppercase;margin-top:5px;color:rgba(255,255,255,.63)}.nav{display:flex;gap:34px;font-size:9px;letter-spacing:.18em;text-transform:uppercase}.nav a{color:rgba(255,255,255,.72)}.nav a:hover{color:#fff}.header-cta{justify-self:end;font-size:9px;letter-spacing:.17em;text-transform:uppercase;border:1px solid rgba(255,255,255,.5);padding:12px 18px}.hero-copy{position:relative;z-index:3;min-height:100svh;width:min(520px,38vw);margin-left:6vw;display:flex;flex-direction:column;justify-content:center;padding:132px 0 145px}.hero-copy .eyebrow{color:var(--gold2)}.hero-title{font:400 clamp(50px,5.8vw,88px)/.92 var(--serif);letter-spacing:.015em;text-transform:uppercase;margin:14px 0 22px}.hero-title span{color:var(--gold2)}.seo-h1{font:400 clamp(18px,1.6vw,24px)/1.25 var(--serif);margin:0 0 18px;max-width:480px}.hero-copy p{font-size:13px;line-height:1.7;color:rgba(255,255,255,.72);max-width:445px;margin:0}.hero-actions{display:flex;gap:12px;margin-top:26px;flex-wrap:wrap}.hero-actions .btn:first-child{background:var(--gold);border-color:var(--gold);color:#fff}.service-rail{position:absolute;z-index:5;bottom:0;left:0;right:0;display:grid;grid-template-columns:repeat(8,1fr);background:rgba(18,13,10,.66);backdrop-filter:blur(12px);border-top:1px solid rgba(255,255,255,.14)}.service-rail a{padding:18px 10px;text-align:center;font-size:9px;letter-spacing:.13em;text-transform:uppercase;color:rgba(255,255,255,.72);border-right:1px solid rgba(255,255,255,.12)}.service-rail a:hover{background:rgba(192,146,79,.16);color:#fff}

/* TRUST */
.trust{background:var(--cream);border-bottom:1px solid var(--line)}.trust-grid{display:grid;grid-template-columns:repeat(4,1fr)}.trust-item{padding:30px 34px;border-right:1px solid var(--line);display:grid;grid-template-columns:38px 1fr;gap:14px}.trust-item:last-child{border-right:0}.trust-symbol{font:400 32px/1 var(--serif);color:var(--gold)}.trust-item b{display:block;font:400 20px/1.1 var(--serif);marg