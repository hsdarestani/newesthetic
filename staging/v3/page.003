x;background:var(--line);border:1px solid var(--line)}.review{background:var(--cream);padding:30px}.stars{color:var(--gold);letter-spacing:.14em}.review p{font:400 18px/1.55 var(--serif);margin:14px 0 20px}.review small{font-size:9px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}

/* EXPERTS */
.experts{background:var(--ink);color:#fff}.experts-grid{display:grid;grid-template-columns:5.2fr 6.8fr;min-height:660px}.experts-copy{padding:clamp(55px,7vw,98px);display:flex;flex-direction:column;justify-content:center}.experts-copy h2{font:400 clamp(48px,5vw,72px)/.96 var(--serif);text-transform:uppercase;margin:12px 0 18px}.experts-copy p{font-size:13px;line-height:1.8;color:rgba(255,255,255,.65);max-width:500px}.experts-media{background:#1a1511;overflow:hidden}.experts-media img{width:100%;height:100%;object-fit:cover;object-position:center 36%}

/* FINAL CTA */
.final-cta{position:relative;min-height:620px;display:grid;place-items:center;text-align:center;color:#fff;overflow:hidden}.final-cta>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.final-cta:after{content:"";position:absolute;inset:0;background:linear-gradient(rgba(18,13,10,.22),rgba(18,13,10,.58))}.final-inner{position:relative;z-index:2;width:min(900px,calc(100% - 40px))}.final-inner h2{font:400 clamp(48px,5.5vw,78px)/.98 var(--serif);text-transform:uppercase;margin:14px 0 24px;text-shadow:0 4px 30px rgba(0,0,0,.25)}.final-inner .btn{background:var(--gold);border-color:var(--gold);color:#fff}

/* CONTACT/FOOTER */
.contact{background:#130f0c;color:#fff;padding:76px 0}.contact-grid{display:grid;grid-template-columns:4fr 8fr;gap:60px}.contact h2{font:400 46px/1 var(--serif);margin:10px 0 20px}.contact p{font-size:12px;line-height:1.8;color:rgba(255,255,255,.58)}.form{display:grid;grid-template-columns:1fr 1fr;gap:12px}.field{display:flex;flex-direction:column;gap:7px}.field label{font-size:8px;letter-spacing:.16em;text-transform:uppercase;color:rgba(255,255,255,.5)}.field input{background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.18);color:#fff;padding:14px}.consent,.submit{grid-column:1/-1}.consent{font-size:11px;color:rgba(255,255,255,.55)}.submit{border:0;background:var(--gold);color:#fff;padding:15px;font-size:9px;letter-spacing:.16em;text-transform:uppercase}.footer{background:#0d0a08;color:rgba(255,255,255,.55);padding:34px 0}.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:28px}.footer h3{font:600 9px/1 var(--sans);letter-spacing:.16em;text-transform:uppercase;color:#fff}.footer p,.footer a{font-size:11px;line-height:1.8}.footer ul{list-style:none;padding:0;margin:0}.copyright{border-top:1px solid rgba(255,255,255,.1);margin-top:28px;padding-top:20px;font-size:10px}

@media(max-width:1000px){.header{grid-template-columns:1fr auto}.nav{display:none}.hero-copy{width:min(600px,58vw)}.service-rail{grid-template-columns:repeat(4,1fr)}.service-rail a:nth-child(n+5){display:none}.trust-grid{grid-template-columns:1fr 1fr}.trust-item:nth-child(2){border-right:0}.trust-item:nth-child(-n+2){border-bottom:1px solid var(--line)}.philosophy-grid{grid-template-columns:1fr}.gold-rule{display:none}.treatments-head{grid-template-columns:1fr}.treatments-head p{justify-self:start}.treatment-grid{grid-template-columns:repeat(2,1fr)}.treatment{grid-column:auto!important}.consult-grid,.quality-grid,.experts-grid,.contact-grid{grid-template-columns:1fr}.consult-media,.quality-media,.experts-media{min-height:520px}.review-grid{grid-template-columns:1fr}.footer-grid{grid-template-columns:1fr 1fr}}
@media(max-width:650px){.wrap{width:min(100% - 28px,1320px)}.header{height:72px;padding:0 18px}.brand{font-size:20px}.header-cta{padding:10px}.hero{min-height:880px}.hero-media{object-position:68% center}.hero:after{background:linear-gradient(180deg,rgba(12,9,7,.05) 0%,rgba(12,9,7,.1) 32%,rgba(12,9,7,.72) 66%,rgba(12,9,7,.95) 100%)}.hero-copy{width:auto;margin:0;padding:420px 18px 150px;justify-content:flex-end}.hero-title{font-size:48px}.service-rail{left:12px;right:12px;grid-template-columns:repeat(2,1fr)}.service-rail a:nth-child(n+3){display:none}.trust-grid{grid-template-columns:1fr}.trust-item{border-right:0;border-bottom:1px solid var(--line)!important}.philosophy,.treatments,.reviews{padding:70px 0}.philosophy-title{font-size:44px}.treatment-grid{grid-template-columns:1fr}.consult-media,.quality-media,.experts-media{min-height:380px}.consult-copy,.quality-copy,.experts-copy{padding:48px 24px}.options{grid-