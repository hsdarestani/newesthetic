in-bottom:7px}.trust-item span{font-size:11px;line-height:1.55;color:var(--muted)}

/* UNSCHLÜSSIG */
.philosophy{padding:92px 0;background:var(--paper)}.philosophy-grid{display:grid;grid-template-columns:5fr 1fr 6fr;gap:26px;align-items:start}.philosophy-title{font:400 clamp(44px,5vw,72px)/.94 var(--serif);text-transform:uppercase;margin:12px 0 0}.gold-rule{width:1px;height:150px;background:linear-gradient(var(--gold),rgba(192,146,79,.05));justify-self:center;margin-top:12px}.philosophy-copy{font-size:14px;line-height:1.85;color:#62584f}.philosophy-copy p{margin:0 0 16px}.statement{font:400 24px/1.35 var(--serif);color:var(--ink);margin-top:26px!important}

/* TREATMENTS */
.treatments{padding:90px 0;background:var(--paper2)}.treatments-head{display:grid;grid-template-columns:4fr 8fr;gap:28px;margin-bottom:28px;align-items:end}.treatments-head h2{font:400 clamp(46px,5.2vw,76px)/.95 var(--serif);text-transform:uppercase;margin:12px 0 0}.treatments-head p{max-width:520px;justify-self:end;color:var(--muted);line-height:1.7;font-size:13px}.treatment-grid{display:grid;grid-template-columns:repeat(12,1fr);grid-auto-rows:minmax(230px,auto);gap:1px;background:rgba(23,18,14,.12);border:1px solid var(--line)}.treatment{background:rgba(250,246,239,.82);padding:26px;display:flex;flex-direction:column;position:relative;overflow:hidden}.treatment:before{content:"";position:absolute;right:-42px;top:-42px;width:120px;height:120px;border:1px solid rgba(192,146,79,.18);border-radius:50%}.treatment:nth-child(1){grid-column:span 5}.treatment:nth-child(2){grid-column:span 4}.treatment:nth-child(3){grid-column:span 3}.treatment:nth-child(4){grid-column:span 3}.treatment:nth-child(5){grid-column:span 4}.treatment:nth-child(6){grid-column:span 5}.treatment:nth-child(7){grid-column:span 7}.treatment:nth-child(8){grid-column:span 5}.treatment .n{font-size:9px;letter-spacing:.18em;color:var(--gold)}.treatment h3{font:400 clamp(24px,2.1vw,34px)/1.05 var(--serif);margin:34px 0 12px}.treatment p{font-size:12px;line-height:1.68;color:var(--muted);margin:0;max-width:560px}.treatment a{margin-top:auto;padding-top:24px;font-size:9px;letter-spacing:.14em;text-transform:uppercase}.treatment a:after{content:" →"}.treatment:hover{background:#fff}

/* CONSULT */
.consult{padding:0;background:var(--ink)}.consult-grid{display:grid;grid-template-columns:6.4fr 5.6fr;min-height:620px}.consult-media{background:#211913;position:relative;overflow:hidden}.consult-media img{width:100%;height:100%;object-fit:cover}.consult-copy{background:var(--ink);color:#fff;padding:clamp(52px,7vw,100px);display:flex;flex-direction:column;justify-content:center}.consult-copy h2{font:400 clamp(46px,5vw,74px)/.98 var(--serif);text-transform:uppercase;margin:12px 0 22px}.consult-copy p{font-size:13px;line-height:1.75;color:rgba(255,255,255,.66);max-width:510px}.consult-copy .btn{width:max-content;margin-top:20px;color:#fff;border-color:rgba(255,255,255,.38)}

/* QUALITY */
.quality{background:var(--cream)}.quality-grid{display:grid;grid-template-columns:6fr 6fr;min-height:670px}.quality-media{background:#d7c4aa;overflow:hidden}.quality-media img{width:100%;height:100%;object-fit:cover}.quality-copy{padding:clamp(50px,7vw,96px);display:flex;flex-direction:column;justify-content:center}.quality-copy h2{font:400 clamp(44px,4.8vw,68px)/.98 var(--serif);text-transform:uppercase;margin:12px 0 18px}.quality-copy>p{font-size:13px;line-height:1.75;color:var(--muted);max-width:520px}.options{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--line);margin-top:34px;border:1px solid var(--line)}.option{padding:24px;background:var(--paper2)}.option.good{background:var(--ink);color:#fff}.option b{font:600 9px/1 var(--sans);letter-spacing:.16em;text-transform:uppercase;color:var(--gold)}.option h3{font:400 28px/1.1 var(--serif);margin:8px 0 10px}.option p{font-size:11px;line-height:1.55;margin:0;opacity:.7}.option ul{list-style:none;padding:0;margin:18px 0 0}.option li{font-size:11px;line-height:1.5;padding:9px 0;border-top:1px solid rgba(110,94,78,.16)}.good li{border-color:rgba(255,255,255,.12)}.good li:before{content:"✓ ";color:var(--gold2)}.option:not(.good) li:before{content:"× ";color:#9a7350}

/* REVIEWS */
.reviews{padding:92px 0;background:var(--paper)}.reviews-head{text-align:center;margin-bottom:42px}.reviews-head h2{font:400 clamp(40px,4.3vw,62px)/1 var(--serif);text-transform:uppercase;margin:12px 0 0}.review-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1p